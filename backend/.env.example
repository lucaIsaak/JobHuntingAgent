# Copy to .env and fill in. Never commit the real .env.

# LLM provider
ANTHROPIC_API_KEY=

# Per-site credentials/API keys, once decided which sites use login vs. public search
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
XING_API_KEY=
STEPSTONE_API_KEY=
INDEED_API_KEY=
GLASSDOOR_API_KEY=

# Storage
DATABASE_URL=

# Live provider
# Set true to include current jobs from Arbeitnow's public API.
JOBHUNTER_LIVE_JOBS=false
# JOBHUNTER_DB_PATH=data/jobhunter.sqlite3

# Optional broad job-market provider. Register at https://developer.adzuna.com/.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=de
